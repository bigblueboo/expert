{
  "name": "@bigblueboo/expert",
  "version": "0.1.0",
  "description": "A blocking GPT-5.6 Pro consultation CLI for agents.",
  "license": "MIT",
  "author": "Charles Deck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigblueboo/expert.git"
  },
  "homepage": "https://github.com/bigblueboo/expert#readme",
  "bugs": {
    "url": "https://github.com/bigblueboo/expert/issues"
  },
  "keywords": [
    "cli",
    "openai",
    "gpt-5",
    "gpt-5-pro",
    "agent",
    "agent-skill",
    "skill",
    "second-opinion",
    "code-review",
    "claude-code",
    "codex"
  ],
  "type": "module",
  "bin": {
    "expert": "dist/cli.js"
  },
  "files": [
